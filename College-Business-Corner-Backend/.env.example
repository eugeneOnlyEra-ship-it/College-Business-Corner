# Copy this file to .env and fill in the values. NEVER commit .env.
# PayPal Developer Dashboard -> Apps & Credentials -> (Sandbox toggle) -> your PLATFORM app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# BN code: shown in the app's settings on the same page
PAYPAL_BN_CODE=
# Partner merchant ID: Sandbox -> Accounts -> "Platform Partner App" -> View/Edit Account -> account ID
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Where PayPal redirects the browser back to (this backend, in dev)
APP_BASE_URL=http://localhost:3000
PORT=3000

# SQLite database file (created by `npx prisma migrate dev`)
DATABASE_URL="file:./dev.db"
# Optional: PayPal sandbox merchant IDs used by the seed script for the two demo sellers.
# Defaults are the author's sandbox sellers; set your own after onboarding yours.
# SEED_PRINT_MERCHANT_ID=
# SEED_SALON_MERCHANT_ID=

# Platform fee taken from each seller's sale, in percent (0-50).
PLATFORM_FEE_PERCENT=10

# Policy engine limits, in cents. Above the first the order is BLOCKED; above the second the buyer must confirm.
POLICY_HARD_CAP_CENTS=10000
POLICY_CONFIRM_ABOVE_CENTS=5000

# Shopping agent (Google AI Studio free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Frontend (Vite) address. When set, PayPal returns the buyer to the app's receipt page instead of JSON.
FRONTEND_URL=http://localhost:5173   # where the app really runs. Used for the PayPal return redirect and (in production) CORS. In development any localhost port may call the API.

# Signs sign-in tokens. Any long random string; e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional in development (a built-in dev value is used), REQUIRED when NODE_ENV=production.
AUTH_SECRET=
