# Copy this file to .env and fill in the values. NEVER commit .env.
# PayPal Developer Dashboard -> Apps & Credentials -> (Sandbox toggle) -> your PLATFORM app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# BN code: shown in the app's settings on the same page
PAYPAL_BN_CODE=
# Partner merchant ID: Sandbox -> Accounts -> "Platform Partner App" -> View/Edit Account -> account ID
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Where PayPal redirects the browser back to (this backend, in dev)
APP_BASE_URL=http://localhost:3000
PORT=3000
