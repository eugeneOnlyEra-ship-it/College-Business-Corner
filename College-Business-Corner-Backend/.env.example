# Copy this file to .env and fill in the values. NEVER commit .env.
# PayPal Developer Dashboard -> Apps & Credentials -> (Sandbox toggle) -> your PLATFORM app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# BN code: shown in the app's settings on the same page
PAYPAL_BN_CODE=
# Partner merchant ID: Sandbox -> Accounts -> "Platform Partner App" -> View/Edit Account -> account ID
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Where PayPal redirects the browser back to (this backend, in dev)
APP_BASE_URL=http://localhost:3000
PORT=3000

# SQLite database file (created by `npx prisma migrate dev`)
DATABASE_URL="file:./dev.db"
# Optional: PayPal sandbox merchant IDs used by the seed script for the two demo sellers.
# Defaults are the author's sandbox sellers; set your own after onboarding yours.
# SEED_PRINT_MERCHANT_ID=
# SEED_SALON_MERCHANT_ID=

# Platform fee taken from each seller's sale, in percent (0-50).
PLATFORM_FEE_PERCENT=10
